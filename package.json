{
  "name": "campus-shield",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source, self-hostable university student safety platform with privacy-by-default architecture",
  "license": "MIT",
  "workspaces": [
    "services/api-server",
    "apps/university-panel"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=services/api-server",
    "dev:panel": "npm run dev --workspace=apps/university-panel",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=services/api-server",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "db:migrate": "cd services/api-server && npm run db:migrate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.18.1"
  }
}
